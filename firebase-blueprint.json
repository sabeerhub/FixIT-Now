{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user of the repair service system.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "description": "User's full name" },
        "email": { "type": "string", "format": "email", "description": "User's email address" },
        "role": { "type": "string", "enum": ["user", "admin"], "description": "User role" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Account creation timestamp" }
      },
      "required": ["uid", "name", "email", "role", "createdAt"]
    },
    "Booking": {
      "title": "Booking",
      "description": "A repair service booking.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Booking ID" },
        "userId": { "type": "string", "description": "ID of the user who made the booking" },
        "userName": { "type": "string", "description": "Name of the user" },
        "serviceType": { "type": "string", "description": "Type of repair service" },
        "description": { "type": "string", "description": "Description of the issue" },
        "date": { "type": "string", "description": "Date of the booking (YYYY-MM-DD)" },
        "time": { "type": "string", "description": "Time of the booking (HH:MM)" },
        "status": { "type": "string", "enum": ["pending", "in-progress", "completed"], "description": "Status of the booking" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Booking creation timestamp" }
      },
      "required": ["id", "userId", "userName", "serviceType", "description", "date", "time", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/Booking" },
      "description": "Stores repair service bookings."
    }
  }
}
